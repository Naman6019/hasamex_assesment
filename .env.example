# Optional: private/local Ollama server. Loopback is the default.
OLLAMA_BASE_URL=http://127.0.0.1:11434

# Optional: hosted OpenAI-compatible evidence selector. Set these only as server-side secrets.
# On Streamlit Community Cloud, paste them into Advanced settings -> Secrets instead of using .env.
# If you leave these blank, a reviewer can enter their own endpoint and key in the sidebar.
CLOUD_MODEL_BASE_URL=
CLOUD_MODEL_NAME=
CLOUD_MODEL_API_KEY=
